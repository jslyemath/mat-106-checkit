\begin{tikzpicture}[scale=1.5, every node/.style={inner sep=0,outer sep=0}, line width=1pt, line style/.style={line width=1pt}]

    \draw[thick] (-0.500,0) -- (0.500,0) -- (0.000,0.866) -- cycle;
    \begin{scope}
        \clip (-0.500,0) -- (0.500,0) -- (0.000,0.866) -- cycle;
        \filldraw[fill=blue!30,draw=black] (-0.500,0) -- (0.000,0) -- (0.000,0.866) -- cycle;
        \filldraw[fill=blue!30,draw=black] (0.000,0) -- (0.500,0) -- (0.000,0.866) -- cycle;
    \end{scope}
    \draw[thick] (0.700,0) -- (1.700,0) -- (1.200,0.866) -- cycle;
    \begin{scope}
        \clip (0.700,0) -- (1.700,0) -- (1.200,0.866) -- cycle;
        \filldraw[fill=blue!30,draw=black] (0.700,0) -- (1.200,0) -- (1.200,0.866) -- cycle;
        \filldraw[fill=white,draw=black] (1.200,0) -- (1.700,0) -- (1.200,0.866) -- cycle;
    \end{scope}
\end{tikzpicture}