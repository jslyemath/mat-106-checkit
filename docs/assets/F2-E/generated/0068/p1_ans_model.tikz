\begin{tikzpicture}[scale=1.5, every node/.style={inner sep=0,outer sep=0}, line width=1pt, line style/.style={line width=1pt}]

    \draw[thick] (1.000,0) arc (0:180:1) -- (-1.000,0) -- cycle;
    \begin{scope}
        \clip (1.000,0) arc (0:180:1) -- (-1.000,0) -- cycle;
        \filldraw[fill=blue!30,draw=black] (0.0,0) -- ++(0.0:1) arc (0.0:45.0:1) -- cycle;
        \filldraw[fill=blue!30,draw=black] (0.0,0) -- ++(45.0:1) arc (45.0:90.0:1) -- cycle;
        \filldraw[fill=blue!30,draw=black] (0.0,0) -- ++(90.0:1) arc (90.0:135.0:1) -- cycle;
        \filldraw[fill=blue!30,draw=black] (0.0,0) -- ++(135.0:1) arc (135.0:180.0:1) -- cycle;
    \end{scope}
    \draw[thick] (3.200,0) arc (0:180:1) -- (1.200,0) -- cycle;
    \begin{scope}
        \clip (3.200,0) arc (0:180:1) -- (1.200,0) -- cycle;
        \filldraw[fill=blue!30,draw=black] (2.2,0) -- ++(0.0:1) arc (0.0:45.0:1) -- cycle;
        \filldraw[fill=blue!30,draw=black] (2.2,0) -- ++(45.0:1) arc (45.0:90.0:1) -- cycle;
        \filldraw[fill=blue!30,draw=black] (2.2,0) -- ++(90.0:1) arc (90.0:135.0:1) -- cycle;
        \filldraw[fill=blue!30,draw=black] (2.2,0) -- ++(135.0:1) arc (135.0:180.0:1) -- cycle;
    \end{scope}
    \draw[thick] (5.400,0) arc (0:180:1) -- (3.400,0) -- cycle;
    \begin{scope}
        \clip (5.400,0) arc (0:180:1) -- (3.400,0) -- cycle;
        \filldraw[fill=blue!30,draw=black] (4.4,0) -- ++(0.0:1) arc (0.0:45.0:1) -- cycle;
        \filldraw[fill=white,draw=black] (4.4,0) -- ++(45.0:1) arc (45.0:90.0:1) -- cycle;
        \filldraw[fill=white,draw=black] (4.4,0) -- ++(90.0:1) arc (90.0:135.0:1) -- cycle;
        \filldraw[fill=white,draw=black] (4.4,0) -- ++(135.0:1) arc (135.0:180.0:1) -- cycle;
    \end{scope}
\end{tikzpicture}